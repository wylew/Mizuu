<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.miz.views.ObservableScrollView
        android:id="@+id/observableScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <!-- Backdrop Banner -->
                <ImageView
                    android:id="@+id/imageBackground"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Poster Card - 160dp x 240dp (25% overlay = 60dp) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardview"
                    android:layout_width="160dp"
                    android:layout_height="240dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="-60dp"
                    android:transitionName="cover"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imageBackground">

                    <ImageView
                        android:id="@+id/traktIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/loading_image" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Text Container Card (Title, Tagline, Description) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/text_container_card"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="24dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:layout_constraintBottom_toBottomOf="@id/cardview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cardview"
                    app:layout_constraintTop_toTopOf="@id/cardview">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/movieTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            tools:text="Jurassic Park" />

                        <TextView
                            android:id="@+id/textView6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textStyle="italic"
                            tools:text="An adventure 65 million years in the making" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/textView2"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="6"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="An industrialist invites some experts to visit his theme park of cloned dinosaurs. After a power failure, the creatures run loose, putting everyone's lives, including his grandchildren's, in danger." />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Info Bar Central Container -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/info_bar_container"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardview">

                    <!-- Background Bar -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/details_card"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="?attr/colorSurfaceVariant"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/details_area"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textView9"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                tools:text="1h 47m" />

                            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/colorOutlineVariant" />

                            <TextView
                                android:id="@+id/textReleaseDate"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                tools:text="1993" />

                            <!-- Space for Play button -->
                            <View android:layout_width="80dp" android:layout_height="match_parent" />

                            <TextView
                                android:id="@+id/textView11"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                tools:text="PG-13" />

                            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/colorOutlineVariant" />

                            <TextView
                                android:id="@+id/textView12"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                tools:text="4.7 Stars" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Play Button - Size: 80dp, Round -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fabCustomSize="80dp"
                        app:maxImageSize="40dp"
                        android:src="@drawable/ic_play_arrow_white_36dp"
                        app:backgroundTint="?attr/colorTertiaryContainer"
                        app:elevation="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="?attr/colorOnTertiaryContainer"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Genre -->
                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/info_bar_container"
                    app:layout_constraintStart_toStartOf="@id/info_bar_container"
                    app:layout_constraintTop_toBottomOf="@id/info_bar_container"
                    tools:text="Action, Adventure, Sci-Fi" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Bottom Sections -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.miz.views.HorizontalCardLayout
                    android:id="@+id/horizontal_card_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.miz.views.HorizontalCardLayout
                    android:id="@+id/horizontal_card_layout_extra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <!-- File path source info -->
                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:drawableStartCompat="@drawable/ic_folder_open_white_24dp"
                    app:drawableTint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

        </LinearLayout>

    </com.miz.views.ObservableScrollView>

    <include layout="@layout/toolbar_layout" />

</FrameLayout>
