<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="8dp"
        app:liftOnScroll="true">

        <include layout="@layout/toolbar_layout" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Floating bottom controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- Library update banner: floats just above the bottom controls.
             When the toggle card is hidden (search mode), goneMarginBottom keeps it above the search bar. -->
        <include
            layout="@layout/library_update_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@+id/toggle_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="68dp" />

        <!-- Search Bar Area -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_card"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:visibility="gone"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/bottom_search_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:iconifiedByDefault="false"
                app:queryBackground="@android:color/transparent"
                app:searchIcon="@drawable/ic_search_white_24dp"
                app:queryHint="@string/stringSearch" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Search Button - Sustainable Implementation -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_search"
            style="@style/Widget.Mizuu.Button.IconOnly"
            app:icon="@drawable/ic_search_white_24dp"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:iconTint="?attr/colorOnSecondaryContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Toggle Group Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/toggle_card"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/fab_menu"
            app:layout_constraintStart_toEndOf="@+id/fab_search">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/library_toggle_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_all"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_video_collection_white_24dp"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    android:text="@string/all"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSurface"
                    app:iconTint="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_movies"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_movie_white_24dp"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    android:text="@string/chooserMovies"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSurface"
                    app:iconTint="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tv"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_tv_white_24dp"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    android:text="@string/chooserTVShows"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSurface"
                    app:iconTint="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </com.google.android.material.card.MaterialCardView>

        <!-- Menu Button - Sustainable Implementation -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_menu"
            style="@style/Widget.Mizuu.Button.IconOnly"
            app:icon="@drawable/ic_more_vert_white_24dp"
            app:backgroundTint="?attr/colorSurfaceContainer"
            app:iconTint="?attr/colorOnSurface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
